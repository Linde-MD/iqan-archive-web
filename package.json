{
  "name": "static-webapp-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stack-neutral static WebApp template for AI-assisted development demos.",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "setup": "npm install && npm run skills:install",
    "skills:install": "npm run skills:sync && uipro init --ai universal",
    "skills:sync": "skills experimental_sync",
    "skills:list": "skills list",
    "skills:preview": "skills experimental_sync --dry-run"
  },
  "skills": [
    "VinkyDev/vibestart@vibestart"
  ],
  "dependencies": {
    "dexie": "^4.4.7",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "skills": "1.7.4",
    "ui-ux-pro-max-cli": "2.15.0"
  }
}
